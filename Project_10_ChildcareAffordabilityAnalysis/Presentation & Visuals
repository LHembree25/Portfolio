ndc_prices_df["Toddler_Center_vs_FCC"] = ndc_prices_df["MCToddler"] - ndc_prices_df["MFCCToddler"]
ndc_prices_df["Preschool_Center_vs_FCC"] = ndc_prices_df["MCPreschool"] - ndc_prices_df["MFCCPreschool"]

