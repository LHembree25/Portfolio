# start cleaning
def clean_money(col):
    return (
        col.astype(str)
           .str.replace(r"[^0-9.\-]", "", regex=True)
           .replace("", np.nan)
           .astype(float)
    )

# identify columns
money_cols = [
    "MCInfant", "MCToddler", "MCPreschool",
    "MFCCInfant", "MFCCToddler", "MFCCPreschool",
    "MHI"
]

# convert
for col in money_cols:
    ndc_prices_df[col] = clean_money(ndc_prices_df[col])

# confirm type
ndc_prices_df.dtypes

# identify columns
household_cols = [
    "H_Under6_BothWork",
    "H_Under6_FWork",
