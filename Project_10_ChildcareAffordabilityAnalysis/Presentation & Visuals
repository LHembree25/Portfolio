# Compute the affordability ratios
ndc_prices_df["InfantCost_to_Income"] = ndc_prices_df["MCInfant"] / ndc_prices_df["MHI"]
ndc_prices_df["ToddlerCost_to_Income"] = ndc_prices_df["MCToddler"] / ndc_prices_df["MHI"]
