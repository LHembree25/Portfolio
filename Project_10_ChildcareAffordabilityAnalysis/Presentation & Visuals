# copy & split
df = ndc_prices_df.copy()
df["bin"] = pd.qcut(df["InfantCost_to_Income"], 6)

# bin em
bin_means = df.groupby("bin").agg({
    "InfantCost_to_Income": "mean",
    "FLFPR_20to64_Under6": "mean"
}).reset_index()

# regression on bin means
coef = np.polyfit(bin_means["InfantCost_to_Income"], bin_means["FLFPR_20to64_Under6"], 1)
line_x = np.array([bin_means["InfantCost_to_Income"].min(), bin_means["InfantCost_to_Income"].max()])
line_y = coef[0] * line_x + coef[1]

# plot
plt.figure(figsize=(8,6))
plt.plot(line_x, line_y, color="black", linewidth=2)
plt.scatter(bin_means["InfantCost_to_Income"], bin_means["FLFPR_20to64_Under6"], s=120, color="steelblue")
plt.title("Binned Regression: Cost-to-Income vs Maternal Participation")
plt.xlabel("Infant Cost as Share of Household Income")
plt.ylabel("Maternal Labor Force Participation (Under 6)")
plt.show()

