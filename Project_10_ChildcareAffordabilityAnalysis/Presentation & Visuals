    "H_Under6_SingleM"
]

# convert
for col in household_cols:
    ndc_prices_df[col] = pd.to_numeric(ndc_prices_df[col], errors="coerce")

# filter unstable data columns out
ndc_prices_df["Under6_Total"] = (
    ndc_prices_df["H_Under6_BothWork"] +
    ndc_prices_df["H_Under6_FWork"] +
    ndc_prices_df["H_Under6_MWork"] +
    ndc_prices_df["H_Under6_SingleM"]
)

