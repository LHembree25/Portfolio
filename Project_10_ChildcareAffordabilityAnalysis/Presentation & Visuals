# take the top 20 counties by affordability burden
top = (
    ndc_prices_df
    .sort_values("InfantCost_to_Income", ascending=False)
    .head(20)
    .copy()
)

# assign counties to 5 arbitrary groups for color variety
top["color_group"] = pd.qcut(top["InfantCost_to_Income"], 5, labels=False)

# flat, non‑gradient infographic colors
palette = [
    "#8dd3c7",  # teal
    "#ffffb3",  # soft yellow
    "#bebada",  # lavender
    "#fb8072",  # coral
    "#80b1d3"   # blue
]

top["color"] = top["color_group"].map(lambda x: palette[int(x)])

labels = top["County_Name"].values
colors = top["color"].values

grid_size = int(np.ceil(np.sqrt(len(labels))))

fig, ax = plt.subplots(figsize=(8, 8))

for i, (label, color) in enumerate(zip(labels, colors)):
    row = i // grid_size
    col = i % grid_size

    # draw flat tile
    rect = plt.Rectangle(
        (col, row), 1, 1,
        facecolor=color,
        edgecolor="white",
        linewidth=2
    )
    ax.add_patch(rect)

    # centered county name
    ax.text(
        col + 0.5, row + 0.5,
        label,
        ha="center", va="center",
        fontsize=8, color="black"
    )

ax.set_xlim(0, grid_size)
ax.set_ylim(0, grid_size)
ax.set_xticks([])
ax.set_yticks([])
ax.set_title("Counties with Highest Affordability Burden")

plt.gca().invert_yaxis()
plt.tight_layout()
plt.show()
