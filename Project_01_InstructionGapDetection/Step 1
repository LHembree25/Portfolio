# Import library
import os
from openai import OpenAI

# Set API key
os.environ["OPENAI_API_KEY"] = "ADD YOUR OWN API" ####### <--------PAY ATTENTION HERE

# build openai prompt
client = OpenAI(api_key=os.environ["OPENAI_API_KEY"])

prompt = """
Identify unclear or incomplete steps in the following instructions.
Explain why a novice would struggle.

Flat tires are one of the most usual repairs that you may need to do because on
the road itself, there are many things that will cause your tyres to burst.

(0) Stop at the road side and put a triangular warning sign to warn cars about stopping.
(1) Locate spare tyres (usually in the car butt bonnet), and make sure that it is inflated.
(2) Engage parking break and vehicle is in Parking Gear (Auto) or in Neutral Gear (Manual).
(3) Use tire wrench to loosen lug nuts.
(4) Jack off car until tire finishes on ground.
(5) Remove lug nuts.
(6) Remove deflated tire.
(7) Replace with spare tyres.
(8) Tighten lug nuts.
(9) Release jack until tire touches ground.
"""

resp = client.chat.completions.create(
    model="gpt-4o-mini",
    messages=[{"role": "user", "content": prompt}]
)

print(resp.choices[0].message.content)

