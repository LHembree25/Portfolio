from transformers import PhiForCausalLM, AutoTokenizer, pipeline

model = PhiForCausalLM.from_pretrained(
    "lex-gap-model",
    trust_remote_code=True,
    device_map="auto"
)

tokenizer = AutoTokenizer.from_pretrained("lex-gap-model")

# pipe parameters
pipe = pipeline(
    "text-generation",
    model=model,
    tokenizer=tokenizer,
    max_new_tokens=400,
    device_map="auto"
)

# Import libraries/packages
from transformers import StoppingCriteria, StoppingCriteriaList
import re

# Stop when model generates NEW steps (10, 11, 12...)
class StopOnNewListStart(StoppingCriteria):
    def __call__(self, input_ids, scores):
        text = tokenizer.decode(input_ids[0], skip_special_tokens=True)

        # Detect ANY new block starting with Step 1
        return (
            re.search(r"\n\([1-9][0-9]\)", text) or
            re.search(r"Step\s1[0-9]?", text)   # catches Step 1, Step 10, Step 11, Step 19
        )

class StopOnRepetition(StoppingCriteria):
    def __call__(self, input_ids, scores):
        text = tokenizer.decode(input_ids[0], skip_special_tokens=True)

        # Detect repeated step-gap lines
        return (
            text.count("Step 0 gap:") > 1 or
            text.count("Step 1 gap:") > 1 or
            text.count("Step 2 gap:") > 1 or
            text.count("Step 3 gap:") > 1 or
            text.count("Step 4 gap:") > 1 or
            text.count("Step 5 gap:") > 1 or
            text.count("Step 6 gap:") > 1 or
            text.count("Step 7 gap:") > 1 or
            text.count("Step 8 gap:") > 1 or
            text.count("Step 9 gap:") > 1
        )
        
stops = StoppingCriteriaList([
    StopOnNewListStart(),
    StopOnRepetition()
])

def run_eval(prompt):
    return pipe(
        prompt + "\n\nAnalysis (begin line-mode):\n",
        max_new_tokens=400,
        do_sample=True,
        temperature=0.2,
        stopping_criteria=stops
    )[0]["generated_text"]

