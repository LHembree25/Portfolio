plt.figure(figsize=(10,6))
sns.scatterplot(data=vg_sales, x="Year", y="Global_Sales")
plt.title("Global Sales by Release Year")
plt.tight_layout()
plt.show()

# Plot
plt.figure(figsize=(10,6))
vg_sales["Platform"].value_counts().plot(kind="bar")
plt.title("Platform Distribution in Historical Sales Data")
plt.xlabel("Platform")
plt.ylabel("Count")
